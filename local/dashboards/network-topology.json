        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 520\" width=\"800\" height=\"520\" font-family=\"sans-serif\"><rect x=\"0\" y=\"0\" width=\"800\" height=\"520\" fill=\"#0d1117\"/><g id=\"cell-link_id:spine1:e1-1:leaf1:e1-49\" stroke=\"#bec8d2\"><line x1=\"400\" y1=\"92\" x2=\"250\" y2=\"228\" stroke-width=\"8\" stroke-linecap=\"round\"/><text x=\"325\" y=\"152\" font-size=\"12\" fill=\"#e6edf3\" text-anchor=\"middle\" stroke=\"none\">0</text></g><rect id=\"cell-spine1:e1-1:leaf1:e1-49\" x=\"376\" y=\"102\" width=\"12\" height=\"12\" rx=\"2\" fill=\"#4BDD33\" stroke=\"#0d1117\" stroke-width=\"1\"/><text x=\"392\" y=\"112\" font-size=\"11\" fill=\"#8b949e\" stroke=\"none\">e1-1</text><g id=\"cell-link_id:spine1:e1-2:leaf2:e1-49\" stroke=\"#bec8d2\"><line x1=\"400\" y1=\"92\" x2=\"550\" y2=\"228\" stroke-width=\"8\" stroke-linecap=\"round\"/><text x=\"475\" y=\"152\" font-size=\"12\" fill=\"#e6edf3\" text-anchor=\"middle\" stroke=\"none\">0</text></g><rect id=\"cell-spine1:e1-2:leaf2:e1-49\" x=\"412\" y=\"102\" width=\"12\" height=\"12\" rx=\"2\" fill=\"#4BDD33\" stroke=\"#0d1117\" stroke-width=\"1\"/><text x=\"428\" y=\"112\" font-size=\"11\" fill=\"#8b949e\" stroke=\"none\">e1-2</text><g id=\"cell-link_id:leaf1:e1-1:client1:eth1\" stroke=\"#bec8d2\"><line x1=\"250\" y1=\"272\" x2=\"250\" y2=\"408\" stroke-width=\"8\" stroke-linecap=\"round\"/><text x=\"250\" y=\"332\" font-size=\"12\" fill=\"#e6edf3\" text-anchor=\"middle\" stroke=\"none\">0</text></g><rect id=\"cell-leaf1:e1-1:client1:eth1\" x=\"244\" y=\"282\" width=\"12\" height=\"12\" rx=\"2\" fill=\"#4BDD33\" stroke=\"#0d1117\" stroke-width=\"1\"/><text x=\"260\" y=\"292\" font-size=\"11\" fill=\"#8b949e\" stroke=\"none\">e1-1</text><g id=\"cell-link_id:leaf2:e1-1:client2:eth1\" stroke=\"#bec8d2\"><line x1=\"550\" y1=\"272\" x2=\"550\" y2=\"408\" stroke-width=\"8\" stroke-linecap=\"round\"/><text x=\"550\" y=\"332\" font-size=\"12\" fill=\"#e6edf3\" text-anchor=\"middle\" stroke=\"none\">0</text></g><rect id=\"cell-leaf2:e1-1:client2:eth1\" x=\"544\" y=\"282\" width=\"12\" height=\"12\" rx=\"2\" fill=\"#4BDD33\" stroke=\"#0d1117\" stroke-width=\"1\"/><text x=\"560\" y=\"292\" font-size=\"11\" fill=\"#8b949e\" stroke=\"none\">e1-1</text><rect x=\"340\" y=\"48\" width=\"120\" height=\"44\" rx=\"7\" fill=\"#2b5f9e\" stroke=\"#c9d1d9\" stroke-width=\"1.5\"/><text x=\"400\" y=\"75\" font-size=\"16\" fill=\"#ffffff\" text-anchor=\"middle\">spine1</text><rect x=\"190\" y=\"228\" width=\"120\" height=\"44\" rx=\"7\" fill=\"#2f7d4f\" stroke=\"#c9d1d9\" stroke-width=\"1.5\"/><text x=\"250\" y=\"255\" font-size=\"16\" fill=\"#ffffff\" text-anchor=\"middle\">leaf1</text><rect x=\"490\" y=\"228\" width=\"120\" height=\"44\" rx=\"7\" fill=\"#2f7d4f\" stroke=\"#c9d1d9\" stroke-width=\"1.5\"/><text x=\"550\" y=\"255\" font-size=\"16\" fill=\"#ffffff\" text-anchor=\"middle\">leaf2</text><rect x=\"190\" y=\"408\" width=\"120\" height=\"44\" rx=\"7\" fill=\"#5a4b8a\" stroke=\"#c9d1d9\" stroke-width=\"1.5\"/><text x=\"250\" y=\"435\" font-size=\"16\" fill=\"#ffffff\" text-anchor=\"middle\">client1</text><rect x=\"490\" y=\"408\" width=\"120\" height=\"44\" rx=\"7\" fill=\"#5a4b8a\" stroke=\"#c9d1d9\" stroke-width=\"1.5\"/><text x=\"550\" y=\"435\" font-size=\"16\" fill=\"#ffffff\" text-anchor=\"middle\">client2</text></svg>",
        "panelConfig": "---\ncellIdPreamble: cell-\ncells:\n  spine1:e1-1:leaf1:e1-49:\n    dataRef: oper-state:spine1:e1-1\n    fillColor:\n      thresholds:\n        - {color: '#FF3154', level: 0}\n        - {color: '#4BDD33', level: 1}\n  link_id:spine1:e1-1:leaf1:e1-49:\n    dataRef: spine1:e1-1:out\n    label:\n      separator: replace\n      units: bps\n      decimalPoints: 1\n    strokeColor:\n      thresholds:\n        - {color: '#bec8d2', level: 0}\n        - {color: '#4BDD33', level: 200000}\n        - {color: '#FFFF00', level: 1000000}\n        - {color: '#FF8000', level: 5000000}\n        - {color: '#FF3154', level: 20000000}\n  spine1:e1-2:leaf2:e1-49:\n    dataRef: oper-state:spine1:e1-2\n    fillColor:\n      thresholds:\n        - {color: '#FF3154', level: 0}\n        - {color: '#4BDD33', level: 1}\n  link_id:spine1:e1-2:leaf2:e1-49:\n    dataRef: spine1:e1-2:out\n    label:\n      separator: replace\n      units: bps\n      decimalPoints: 1\n    strokeColor:\n      thresholds:\n        - {color: '#bec8d2', level: 0}\n        - {color: '#4BDD33', level: 200000}\n        - {color: '#FFFF00', level: 1000000}\n        - {color: '#FF8000', level: 5000000}\n        - {color: '#FF3154', level: 20000000}\n  leaf1:e1-1:client1:eth1:\n    dataRef: oper-state:leaf1:e1-1\n    fillColor:\n      thresholds:\n        - {color: '#FF3154', level: 0}\n        - {color: '#4BDD33', level: 1}\n  link_id:leaf1:e1-1:client1:eth1:\n    dataRef: leaf1:e1-1:out\n    label:\n      separator: replace\n      units: bps\n      decimalPoints: 1\n    strokeColor:\n      thresholds:\n        - {color: '#bec8d2', level: 0}\n        - {color: '#4BDD33', level: 200000}\n        - {color: '#FFFF00', level: 1000000}\n        - {color: '#FF8000', level: 5000000}\n        - {color: '#FF3154', level: 20000000}\n  leaf2:e1-1:client2:eth1:\n    dataRef: oper-state:leaf2:e1-1\n    fillColor:\n      thresholds:\n        - {color: '#FF3154', level: 0}\n        - {color: '#4BDD33', level: 1}\n  link_id:leaf2:e1-1:client2:eth1:\n    dataRef: leaf2:e1-1:out\n    label:\n      separator: replace\n      units: bps\n      decimalPoints: 1\n    strokeColor:\n      thresholds:\n        - {color: '#bec8d2', level: 0}\n        - {color: '#4BDD33', level: 200000}\n        - {color: '#FFFF00', level: 1000000}\n        - {color: '#FF8000', level: 5000000}\n        - {color: '#FF3154', level: 20000000}\n",
        "siteConfig": "https://raw.githubusercontent.com/srl-labs/srl-telemetry-lab/refs/heads/flow_panel/configs/grafana/flow_panels/siteconfig.yml"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace((2 - kentik_snmp_if_OperStatus{device_name=~\".+\", device_name!=\"\"}), \"iface_short\", \"e$1-$2\", \"if_Description\", \"ethernet-(\\\\d+)/(\\\\d+)\")",
          "legendFormat": "oper-state:{{device_name}}:{{iface_short}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(rate(kentik_snmp_ifHCOutOctets{device_name=~\".+\", device_name!=\"\"}[$__rate_interval]) * 8, \"iface_short\", \"e$1-$2\", \"if_Description\", \"ethernet-(\\\\d+)/(\\\\d+)\")",
